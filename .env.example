# Copie este archivo como .env para ejecutar el servicio localmente.
# .env esta excluido del repositorio: nunca versione credenciales reales.

DB_USER=postgres
DB_PASSWORD=cambieme
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blacklist

# Token Bearer estatico que deben presentar los clientes del API.
STATIC_BEARER_TOKEN=cambieme-por-un-token-largo-y-aleatorio
