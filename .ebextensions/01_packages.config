# Paquetes del sistema instalados en cada instancia EC2 del entorno.
# libpq-devel y gcc permiten compilar psycopg2 desde fuente si la rueda
# precompilada (psycopg2-binary) no estuviera disponible para la plataforma.
# En plataformas Amazon Linux 2 el paquete equivalente es postgresql-devel.
packages:
  yum:
    libpq-devel: []
    gcc: []
