# Configuracion de plataforma aplicada a cada instancia del entorno.
#
# NOTA TECNICA
# Este archivo instalaba antes los paquetes de sistema libpq-devel y gcc, que
# permiten compilar psycopg2 desde fuente. Ese bloque se retiro por dos razones:
#
#   1. No hacen falta: el proyecto usa psycopg2-binary, que se distribuye como
#      rueda precompilada y no necesita compilador ni cabeceras de PostgreSQL.
#
#   2. Rompian los redespliegues. En cada despliegue posterior a la creacion
#      del entorno, cfn-init volvia a ejecutar la instalacion de paquetes en la
#      fase PreBuildEbExtension y fallaba, dejando el despliegue colgado:
#      "Command execution completed on all instances.
#       Summary: [Successful: 0, Failed: 2, TimedOut: 1]".
#
# En su lugar se fija aqui la ruta del health check, de modo que la
# configuracion viaja con el codigo y no depende de ajustes manuales en la
# consola de AWS.
option_settings:
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /
